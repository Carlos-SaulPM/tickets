        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"usuario@example.com\",\n  \"contrasena\": \"usuario123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Inicia sesión\", () => pm.response.to.have.status(200));",
              "const datos = pm.response.json();",
