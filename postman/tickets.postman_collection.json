        ],
        "url": {
          "raw": "{{baseUrl}}/tickets/{{ticketId}}/asignar",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tickets",
            "{{ticketId}}",
            "asignar"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"asignado_a_id\": \"{{soporteId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Asigna el ticket\", () => pm.response.to.have.status(200));",
              "pm.test(\"Pasa a En_proceso\", () => pm.expect(pm.response.json().data.estado).to.eql(\"En_proceso\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "11. Responder el ticket",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{soporteToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
