              "pm.test(\"Rol usuario\", () => pm.expect(datos.usuario.rol).to.eql(\"Usuario\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "05. Listar categorías",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/categorias",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "categorias"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
              "const datos = pm.response.json().data;",
              "pm.collectionVariables.set(\"categoriaId\", datos[0].id);",
              "pm.test(\"Devuelve categorías\", () => pm.expect(datos.length).to.be.above(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "06. Listar áreas activas",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/areas?activo=true",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "areas?activo=true"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
              "const datos = pm.response.json().data;",
              "pm.collectionVariables.set(\"areaId\", datos[0].id);",
              "pm.test(\"Devuelve áreas\", () => pm.expect(datos.length).to.be.above(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "07. Crear ticket",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{usuarioToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tickets",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tickets"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"asunto\": \"Prueba desde Postman\",\n  \"descripcion\": \"Ticket creado por la colección de pruebas de la API.\",\n  \"categoria_id\": \"{{categoriaId}}\",\n  \"area_id\": \"{{areaId}}\",\n  \"prioridad\": \"Media\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Crea el ticket\", () => pm.response.to.have.status(201));",
              "const datos = pm.response.json().data;",
              "pm.collectionVariables.set(\"ticketId\", datos.id);",
              "pm.test(\"Empieza abierto\", () => pm.expect(datos.estado).to.eql(\"Abierto\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "08. Listar tickets del usuario",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{usuarioToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tickets?pagina=1&limite=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tickets?pagina=1&limite=10"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
              "const cuerpo = pm.response.json();",
              "pm.test(\"Devuelve una lista\", () => pm.expect(cuerpo.data).to.be.an(\"array\"));",
              "pm.test(\"Incluye el ticket creado\", () => pm.expect(cuerpo.data.some(t => t.id === pm.collectionVariables.get(\"ticketId\"))).to.be.true);"
            ]
          }
        }
      ]
    },
    {
      "name": "09. Ver detalle del ticket",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{usuarioToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tickets/{{ticketId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tickets",
            "{{ticketId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
              "const datos = pm.response.json().data;",
              "pm.test(\"Es el ticket creado\", () => pm.expect(datos.id).to.eql(pm.collectionVariables.get(\"ticketId\")));"
            ]
          }
        }
      ]
    },
