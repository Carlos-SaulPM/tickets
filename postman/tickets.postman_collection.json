        "url": {
          "raw": "{{baseUrl}}/tickets/{{ticketId}}/mensajes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tickets",
            "{{ticketId}}",
            "mensajes"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mensaje\": \"<p>Respuesta enviada desde Postman.</p>\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Registra el mensaje\", () => pm.response.to.have.status(201));",
              "pm.test(\"No es nota interna\", () => pm.expect(pm.response.json().data.es_nota_interna).to.be.false);"
            ]
          }
        }
      ]
    },
