{
  "info": {
    "name": "Sistema de Tickets",
    "description": "Colección de pruebas de la API del Sistema de Tickets.\n\nSe ejecuta completa desde el Collection Runner o con newman. El orden crea un ticket, lo asigna, lo responde, propone una solución y lo cierra.\n\nAntes de ejecutar, ajustar la variable baseUrl si la API no está en localhost:3000.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1"
    }
  ],
  "item": [
    {
      "name": "01. Salud",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/salud",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "salud"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Estado ok\", () => pm.expect(pm.response.json().estado).to.eql(\"ok\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "02. Login administrador",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/autenticacion/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "autenticacion",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"admin@example.com\",\n  \"contrasena\": \"admin123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Inicia sesión\", () => pm.response.to.have.status(200));",
              "const datos = pm.response.json();",
              "pm.collectionVariables.set(\"adminToken\", datos.token);",
              "pm.test(\"Rol administrador\", () => pm.expect(datos.usuario.rol).to.eql(\"Administrador\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "03. Login soporte",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/autenticacion/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "autenticacion",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"soporte@example.com\",\n  \"contrasena\": \"soporte123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Inicia sesión\", () => pm.response.to.have.status(200));",
              "const datos = pm.response.json();",
              "pm.collectionVariables.set(\"soporteToken\", datos.token);",
              "pm.collectionVariables.set(\"soporteId\", datos.usuario.id);",
              "pm.test(\"Rol soporte\", () => pm.expect(datos.usuario.rol).to.eql(\"Soporte\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "04. Login usuario",
      "request": {
