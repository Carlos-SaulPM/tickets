# Solo COMPOSE_PROFILES y JWT_SECRET son obligatorias. El resto tiene un valor
# por defecto en docker-compose.yml: solo es necesario definir las variables
# que se quieran cambiar. Las variables comentadas son opcionales.

# Perfil de Docker Compose: dev | prod | dev,tunnel-dev | prod,tunnel-prod
COMPOSE_PROFILES=dev

# JWT (obligatoria, mínimo 32 caracteres)
JWT_SECRET=clave-de-ejemplo-cambiar-en-produccion
# JWT_EXPIRES_IN=3600

# Base de datos (por defecto postgres / postgres / tickets)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tickets

# API que consume el navegador. Sin definir usa :3000 en dev y :8080 en prod.
# Con túnel, debe apuntar a la URL pública del backend.
# NEXT_PUBLIC_API_URL=https://<backend>.trycloudflare.com/api/v1

# API para SSR dentro de Compose. Sin definir usa app:3000 (dev) o app-prod:3000 (prod).
# API_URL_INTERNA=http://app:3000/api/v1

# Base de los enlaces en los correos. Sin definir usa :3001 (dev) o :8081 (prod).
# FRONTEND_URL=https://<frontend>.trycloudflare.com

# Correo saliente. En desarrollo lo captura Mailpit (http://localhost:8025).
# Si SMTP_HOST queda vacío, el backend solo imprime los correos en consola.
SMTP_HOST=mailpit
SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Sistema de Tickets <no-reply@sistema-tickets.local>"

# Datos de demostración: 60 tickets y 15 usuarios. No se usa en producción.
SEED_DEMO=false

# Puertos en el host (por defecto los indicados)
# MAILPIT_PORT=8025
# APP_PORT=3000
# APP_PROD_PORT=8080
# FRONTEND_PORT=3001
# FRONTEND_PROD_PORT=8081

# Cloudflare Tunnel: se cambia a http2 si la red bloquea UDP/7844.
# CLOUDFLARE_TUNNEL_PROTOCOL=http2
