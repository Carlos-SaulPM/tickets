# Perfil de Docker Compose: dev | prod
COMPOSE_PROFILES=dev

# Base de datos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tickets

# JWT
JWT_SECRET=cambia-esta-clave-por-una-de-al-menos-32-caracteres
JWT_EXPIRES_IN=3600

# Puertos en el host
APP_PORT=3000
APP_PROD_PORT=8080
FRONTEND_PORT=3001
FRONTEND_PROD_PORT=8081
